Here is the leanest, purest core: **rectangles only**. 

All fonts, textures, text pools, and glyph tables are stripped out. The entire rendering pipeline compiles down to flat colored vertices rendered in a single GLES 2.0 draw call.

---

### 1. `src/rui.h` (Public Interface)

```c
#ifndef RUI_H
#define RUI_H

#include <stdint.h>

#ifdef __cplusplus
extern "C" {
#endif

#define RUI_MAX_COMMANDS 1024

typedef struct {
  int32_t x;
  int32_t y;
  int32_t w;
  int32_t h;
} rui_Rect;

typedef struct {
  uint8_t r;
  uint8_t g;
  uint8_t b;
  uint8_t a;
} rui_Color;

typedef enum {
  RUI_CMD_RECT = 1
} rui_CmdType;

typedef struct {
  rui_CmdType type;
  rui_Rect rect;
  rui_Color color;
} rui_Command;

typedef struct {
  int32_t screen_w;
  int32_t screen_h;

  rui_Command commands[RUI_MAX_COMMANDS];
  int32_t command_count;
} rui_Context;

static inline rui_Rect rui_rect(int32_t x, int32_t y, int32_t w, int32_t h) {
  rui_Rect r = {.x = x, .y = y, .w = w, .h = h};
  return r;
}

static inline rui_Color rui_color(uint8_t r, uint8_t g, uint8_t b, uint8_t a) {
  rui_Color c = {.r = r, .g = g, .b = b, .a = a};
  return c;
}

void rui_init(rui_Context *ctx);
void rui_begin(rui_Context *ctx, int32_t screen_w, int32_t screen_h);
void rui_end(rui_Context *ctx);

void rui_draw_rect(rui_Context *ctx, rui_Rect rect, rui_Color color);

#ifdef __cplusplus
}
#endif

#endif /* RUI_H */
```

